# --- Language model -----------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
# Second provider (M-01). Set LLM_PROVIDER=huggingface to run the same
# investigation on it with no code change; it is also the automatic fallback
# when the primary is rate-limited or unreachable.
LLM_FALLBACK_PROVIDER=huggingface
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

GROQ_API_KEY=

# --- Open-source intelligence -------------------------------------------------
# Tavily powers the OSINT sweep and the compliance fallback search.
TAVILY_API_KEY=

# --- SEC EDGAR ----------------------------------------------------------------
# No key required. The SEC does require a descriptive User-Agent carrying a real
# contact address, and rate-limits requests that omit one.
SEC_USER_AGENT=Sentinel Compliance Research (contact: you@example.com)

# --- OpenSanctions (optional) -------------------------------------------------
# Without this the screen still runs against the local OFAC SDN list in
# datasets/. With it, coverage extends to the EU, UN and UK consolidated lists
# and politically exposed persons. Free non-commercial tier:
#   https://www.opensanctions.org/api/
OPENSANCTIONS_API_KEY=

# --- Data services ------------------------------------------------------------
# `docker compose up -d` starts Postgres and Redis. The host ports are
# parameterised so the stack can coexist with another local Postgres; a fresh
# machine can leave them at the defaults.
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_password
POSTGRES_DB=sentinel_db

# Postgres is the system of record AND the checkpoint store: without it an
# interrupted investigation cannot be resumed after a restart (objective M-10).
DATABASE_URL=postgresql+psycopg://sentinel_user:sentinel_password@127.0.0.1:5432/sentinel_db
REDIS_URL=redis://127.0.0.1:6379/0

# --- Optional -----------------------------------------------------------------
HF_TOKEN=
